#include <stdio.h>

#define MAX 5

int stack[MAX];
int top = -1;

void Initstack()
{
    top = -1;
    printf("Stack initialized\n");
}

int Isempty()
{
    return top == -1;
}

void push(int value)
{
    if (top == MAX - 1)
        printf("Stack is full\n");
    else
    {
        stack[++top] = value;
        printf("%d pushed\n", value);
    }
}

void Pop()
{
    if (Isempty())
        printf("Stack is empty\n");
    else
        printf("Popped element: %d\n", stack[top--]);
}

void Peek()
{
    if (Isempty())
        printf("Stack is empty\n");
    else
        printf("Top element: %d\n", stack[top]);
}

int main()
{
    int choice, value;

    Initstack();

    do
    {
        printf("\n1. Push\n2. Pop\n3. IsEmpty\n4. Peek\n0. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                printf("Enter value: ");
                scanf("%d", &value);
                push(value);
                break;
            case 2:
                Pop();
                break;
            case 3:
                if (Isempty())
                    printf("Stack is empty\n");
                else
                    printf("Stack is not empty\n");
                break;
            case 4:
                Peek();
                break;
            case 0:
                break;
            default:
                printf("Invalid choice\n");
        }
    } while (choice != 0);

    return 0;
}
