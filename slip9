#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main()
{
    int a[100], n, x, i, found = 0;

    srand(time(NULL));

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n <= 0 || n > 100)
    {
        printf("Invalid size\n");
        return 0;
    }

    printf("Random array: ");
    for (i = 0; i < n; i++)
    {
        a[i] = rand() % 100;
        printf("%d ", a[i]);
    }

    printf("\nEnter value to search: ");
    scanf("%d", &x);

    for (i = 0; i < n; i++)
    {
        if (a[i] == x)
        {
            printf("Element found at position %d\n", i + 1);
            found = 1;
            break;
        }
    }

    if (!found)
        printf("Element not found\n");

    return 0;
}
